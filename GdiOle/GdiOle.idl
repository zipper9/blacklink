// GdiOle.idl : IDL source for ImageOle
//

// This file will be processed by the MIDL tool to
// produce the type library (GdiOle.tlb) and marshalling code.

#include "olectl.h"
import "oaidl.idl";
import "ocidl.idl";

[
	object,
	uuid(b8b8469b-df53-433d-b52c-2935be4e5fb8),
	dual,
	nonextensible,
	helpstring("IGdiOle Interface"),
	pointer_default(unique)
]
interface IGDIImage : IDispatch
{
	[propget, id(1)] HRESULT Text([out, retval] BSTR *text);
	[propput, id(1)] HRESULT Text([in] BSTR text);
	[propget, id(2)] HRESULT BackgroundColor([out, retval] COLORREF *color);
	[propput, id(2)] HRESULT BackgroundColor([in] COLORREF color);
	[propget, id(3)] HRESULT Flags([out, retval] int *flags);
	[propput, id(3)] HRESULT Flags([in] int flags);
	[propget, id(4)] HRESULT EmoticonId([out, retval] int *id);
	[propput, id(4)] HRESULT EmoticonId([in] int id);
	[local] HRESULT ReplaceImage([in] void *img);
};

[
	uuid(fcd3e50d-3528-4ede-8a32-c4db831ac4b8),
	version(1.0),
	helpstring("GdiOle 1.0 Type Library")
]
library GdiOleLib
{
	importlib("stdole2.tlb");
	[
		uuid(a8bf8f4c-506e-417c-9bc1-e71f3162423c),
		control,
		helpstring("GdiOle")
	]
	coclass GDIImage
	{
		[default] interface IGDIImage;
	};
};
